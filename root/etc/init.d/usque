#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/usque
CONFIG_FILE=/etc/usque/config.json

start_service() {
    local enabled

    config_load usque
    config_get_bool enabled global enabled 0
    [ "$enabled" -eq 0 ] && return

    [ -f "$CONFIG_FILE" ] || {
        echo "usque: config not found, skipping start"
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" -c "$CONFIG_FILE" nativetun
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    :
}

service_triggers() {
    procd_add_reload_trigger "usque"
}