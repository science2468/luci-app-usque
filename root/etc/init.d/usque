#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/usque
CONFIG_FILE=/etc/usque/config.json

start_service() {
    [ -f "$CONFIG_FILE" ] || {
        echo "usque: config not found, refusing to start"
        return 1
    }

    procd_open_instance "usque"
    procd_set_param command "$PROG" -c "$CONFIG_FILE" nativetun
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    :
}